{
  "name": "school-management-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node scripts/dev.js",
    "check": "node scripts/check.js",
    "dev:server": "nodemon --legacy-watch --signal SIGTERM --watch server.js --watch src --ext js,json --exec \"node --env-file=.env server.js\"",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/styles/app.css -o ./public/css/app.css --minify",
    "dev:css": "tailwindcss -i ./src/styles/app.css -o ./public/css/app.css --watch=always",
    "test": "node --test",
    "setup:admin": "node --env-file=.env scripts/create-admin.js",
    "test:integration": "node --env-file=.env --test tests/*.integration.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-mongo": "^6.0.0",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "mongoose": "^9.9.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3"
  }
}
