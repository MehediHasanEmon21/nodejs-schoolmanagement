<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Results' }] }) %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <%- include('../partials/header', { eyebrow: 'Marks and results', heading: 'Results', description: 'Open mark entry, class results and student result summaries for configured exams.' }) %>
  <% if (locals.navigation.some((item) => item.id === 'results')) { %><a href="/results/entry" class="btn btn-primary">Enter marks</a><% } %>
</div>
<% if (message) { %><div class="mb-5"><%- include('../partials/alert', { kind: 'success', message }) %></div><% } %>
<section class="panel overflow-x-auto" aria-labelledby="result-exams-title" tabindex="0">
  <table class="w-full border-collapse text-left text-sm">
    <caption id="result-exams-title" class="px-5 py-4 text-left font-semibold text-slate-900">Exam result workspaces</caption>
    <thead class="border-y border-slate-200 bg-slate-50 text-slate-600">
      <tr><th scope="col" class="px-5 py-3 font-medium">Exam</th><th scope="col" class="px-5 py-3 font-medium">Class</th><th scope="col" class="px-5 py-3 font-medium">Year</th><th scope="col" class="px-5 py-3 font-medium">Subjects</th><th scope="col" class="px-5 py-3 font-medium">Actions</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% for (const exam of formOptions.exams) { %>
        <tr>
          <td class="px-5 py-4 font-medium text-slate-900"><%= exam.name %></td>
          <td class="px-5 py-4 text-slate-600"><%= exam.class.name %></td>
          <td class="px-5 py-4 text-slate-600"><%= exam.academicYear.name %></td>
          <td class="px-5 py-4 text-slate-600"><%= exam.subjects.length %></td>
          <td class="px-5 py-4">
            <div class="flex flex-wrap gap-2">
              <a href="/results/exams/<%= exam._id %>/class" class="btn btn-secondary">Class result</a>
              <% if (exam.subjects[0]) { %><a href="/results/entry?exam=<%= exam._id %>&subject=<%= exam.subjects[0].subject._id %>" class="btn btn-secondary">Marks</a><% } %>
            </div>
          </td>
        </tr>
      <% } %>
      <% if (formOptions.exams.length === 0) { %><tr><td colspan="5" class="px-5 py-10 text-center text-slate-500">No scheduled exams are ready for results.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../layouts/end') %>
