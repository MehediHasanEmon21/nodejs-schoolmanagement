<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Teachers', href: '/teachers' }, { label: teacher.name }] }) %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <%- include('../partials/header', { eyebrow: 'Teacher profile', heading: teacher.name, description: 'Profile details for this teacher record.' }) %>
  <% if (canManage) { %><a href="/teachers/<%= teacher.id %>/edit" class="btn btn-primary">Edit</a><% } %>
</div>
<section class="panel px-5 py-6 sm:px-6" aria-labelledby="teacher-profile-title">
  <h2 id="teacher-profile-title" class="mb-5 text-base font-semibold text-slate-900">Profile</h2>
  <dl class="grid gap-5 sm:grid-cols-2">
    <div><dt class="text-xs font-semibold tracking-widest text-slate-500 uppercase">Teacher ID</dt><dd class="mt-1 text-slate-900"><%= teacher.teacherId %></dd></div>
    <div><dt class="text-xs font-semibold tracking-widest text-slate-500 uppercase">Status</dt><dd class="mt-1 capitalize text-slate-900"><%= teacher.status %></dd></div>
    <div><dt class="text-xs font-semibold tracking-widest text-slate-500 uppercase">Email</dt><dd class="mt-1 text-slate-900"><%= teacher.email %></dd></div>
    <div><dt class="text-xs font-semibold tracking-widest text-slate-500 uppercase">Phone</dt><dd class="mt-1 text-slate-900"><%= teacher.phone || '—' %></dd></div>
    <div><dt class="text-xs font-semibold tracking-widest text-slate-500 uppercase">Joining date</dt><dd class="mt-1 text-slate-900"><%= teacher.joiningDate.toISOString().slice(0, 10) %></dd></div>
    <div><dt class="text-xs font-semibold tracking-widest text-slate-500 uppercase">Linked account</dt><dd class="mt-1 text-slate-900"><%= teacher.user ? teacher.user.name + ' - ' + teacher.user.email : '—' %></dd></div>
    <div class="sm:col-span-2"><dt class="text-xs font-semibold tracking-widest text-slate-500 uppercase">Qualification</dt><dd class="mt-1 whitespace-pre-line text-slate-900"><%= teacher.qualification || '—' %></dd></div>
  </dl>
  <% if (canManage) { %>
    <form method="post" action="/teachers/<%= teacher.id %>/status" class="mt-6">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="status" value="<%= teacher.status === 'active' ? 'inactive' : 'active' %>">
      <button class="btn btn-secondary" type="submit"><%= teacher.status === 'active' ? 'Deactivate' : 'Activate' %></button>
    </form>
  <% } %>
</section>
<%- include('../layouts/end') %>
