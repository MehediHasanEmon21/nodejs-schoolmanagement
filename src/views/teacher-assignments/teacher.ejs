<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Teacher assignments', href: '/teacher-assignments' }, { label: teacher.name }] }) %>
<%- include('../partials/header', { eyebrow: 'Teacher responsibility', heading: teacher.name, description: 'Academic assignments for this teacher.' }) %>
<section class="panel mt-6 overflow-x-auto" aria-labelledby="teacher-assignments-title" tabindex="0">
  <table class="w-full border-collapse text-left text-sm">
    <caption id="teacher-assignments-title" class="px-5 py-4 text-left font-semibold text-slate-900">Teacher assignments</caption>
    <thead class="border-y border-slate-200 bg-slate-50 text-slate-600">
      <tr><th scope="col" class="px-5 py-3 font-medium">Subject</th><th scope="col" class="px-5 py-3 font-medium">Class</th><th scope="col" class="px-5 py-3 font-medium">Section</th><th scope="col" class="px-5 py-3 font-medium">Year</th><th scope="col" class="px-5 py-3 font-medium">Status</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% for (const assignment of records) { %>
        <tr>
          <td class="px-5 py-4 font-medium text-slate-900"><a href="/teacher-assignments/<%= assignment._id %>" class="hover:text-teal-800"><%= assignment.subject.name %></a></td>
          <td class="px-5 py-4 text-slate-600"><%= assignment.class.name %></td>
          <td class="px-5 py-4 text-slate-600"><%= assignment.section.name %></td>
          <td class="px-5 py-4 text-slate-600"><%= assignment.academicYear.name %></td>
          <td class="px-5 py-4 capitalize"><%= assignment.status %></td>
        </tr>
      <% } %>
      <% if (records.length === 0) { %><tr><td colspan="5" class="px-5 py-10 text-center text-slate-500">No teacher assignments are available.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../partials/pagination', { page: filters.page, totalPages, previousUrl, nextUrl }) %>
<%- include('../layouts/end') %>
