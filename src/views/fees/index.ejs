<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Fees' }] }) %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <%- include('../partials/header', { eyebrow: 'Student fees', heading: 'Fees', description: 'Track assigned fee obligations, due dates and outstanding balances.' }) %>
  <% if (canManage) { %><div class="flex flex-wrap gap-2"><a href="/fees/types" class="btn btn-secondary">Fee types</a><a href="/fees/new" class="btn btn-primary">Assign fee</a></div><% } %>
</div>
<% if (message) { %><div class="mb-5"><%- include('../partials/alert', { kind: 'success', message }) %></div><% } %>
<section class="panel mb-5 px-5 py-5 sm:px-6" aria-labelledby="fee-filters-title">
  <h2 id="fee-filters-title" class="mb-4 text-base font-semibold text-slate-900">Find fees</h2>
  <form method="get" action="/fees" class="grid gap-4 lg:grid-cols-[repeat(5,minmax(0,1fr))_auto] lg:items-end">
    <%- include('../partials/form-control', { name: 'academicYear', label: 'Academic year', value: filters.academicYear, options: [{ value: '', label: 'All years' }, ...formOptions.academicYears.map((item) => ({ value: item._id, label: item.name }))] }) %>
    <%- include('../partials/form-control', { name: 'feeType', label: 'Fee type', value: filters.feeType, options: [{ value: '', label: 'All fee types' }, ...formOptions.feeTypes.map((item) => ({ value: item._id, label: item.name }))] }) %>
    <%- include('../partials/form-control', { name: 'status', label: 'Status', value: filters.status, options: [{ value: '', label: 'All statuses' }, { value: 'pending', label: 'Pending' }, { value: 'partial', label: 'Partial' }, { value: 'paid', label: 'Paid' }, { value: 'waived', label: 'Waived' }, { value: 'cancelled', label: 'Cancelled' }] }) %>
    <%- include('../partials/form-control', { name: 'student', label: 'Student', value: filters.student, options: [{ value: '', label: 'All students' }, ...formOptions.students.map((item) => ({ value: item._id, label: item.firstName + ' ' + item.lastName }))] }) %>
    <%- include('../partials/form-control', { name: 'sort', label: 'Sort', value: filters.sort, options: [{ value: 'dueDate', label: 'Due date' }, { value: 'amount', label: 'Amount' }, { value: 'status', label: 'Status' }] }) %>
    <button class="btn btn-secondary" type="submit">Apply</button>
  </form>
</section>
<section class="panel overflow-x-auto" aria-labelledby="fees-title" tabindex="0">
  <table class="w-full border-collapse text-left text-sm">
    <caption id="fees-title" class="px-5 py-4 text-left font-semibold text-slate-900">Fee assignments</caption>
    <thead class="border-y border-slate-200 bg-slate-50 text-slate-600">
      <tr><th scope="col" class="px-5 py-3 font-medium">Student</th><th scope="col" class="px-5 py-3 font-medium">Fee</th><th scope="col" class="px-5 py-3 font-medium">Year</th><th scope="col" class="px-5 py-3 font-medium">Due</th><th scope="col" class="px-5 py-3 font-medium">Outstanding</th><th scope="col" class="px-5 py-3 font-medium">Status</th><th scope="col" class="px-5 py-3 font-medium">Actions</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% for (const fee of records) { %>
        <tr>
          <td class="px-5 py-4 font-medium text-slate-900"><a href="/fees/<%= fee._id %>" class="hover:text-teal-800"><%= fee.student.firstName %> <%= fee.student.lastName %></a></td>
          <td class="px-5 py-4 text-slate-600"><%= fee.feeType.name %></td>
          <td class="px-5 py-4 text-slate-600"><%= fee.academicYear.name %></td>
          <td class="px-5 py-4 text-slate-600"><%= fee.dueDate.toISOString().slice(0, 10) %></td>
          <td class="px-5 py-4 text-slate-600"><%= fee.summary.outstanding.toFixed(2) %></td>
          <td class="px-5 py-4"><%= fee.status[0].toUpperCase() + fee.status.slice(1) %><%= fee.summary.overdue ? ' · Overdue' : '' %></td>
          <td class="px-5 py-4"><div class="flex flex-wrap gap-2"><a href="/fees/<%= fee._id %>" class="btn btn-secondary">View</a><% if (canManage) { %><a href="/fees/<%= fee._id %>/edit" class="btn btn-secondary">Edit</a><% } %></div></td>
        </tr>
      <% } %>
      <% if (records.length === 0) { %><tr><td colspan="7" class="px-5 py-10 text-center text-slate-500">No fees match the current filters.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../partials/pagination', { page: filters.page, totalPages, previousUrl, nextUrl }) %>
<%- include('../layouts/end') %>
