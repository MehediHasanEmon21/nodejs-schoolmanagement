<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Notices' }] }) %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <%- include('../partials/header', { eyebrow: 'Announcements', heading: 'Notices', description: 'Read current school notices and announcements for your role or class.' }) %>
  <% if (canManage) { %><a href="/notices/new" class="btn btn-primary">New notice</a><% } %>
</div>
<% if (message) { %><div class="mb-5"><%- include('../partials/alert', { kind: 'success', message }) %></div><% } %>
<section class="panel mb-5 px-5 py-5 sm:px-6" aria-labelledby="notice-filters-title">
  <h2 id="notice-filters-title" class="mb-4 text-base font-semibold text-slate-900">Find notices</h2>
  <form method="get" action="/notices" class="grid gap-4 lg:grid-cols-[minmax(0,1.5fr)_repeat(2,minmax(0,1fr))_auto] lg:items-end">
    <%- include('../partials/form-control', { name: 'q', type: 'search', label: 'Search', value: filters.q, hint: 'Title or body' }) %>
    <% if (canManage) { %>
      <%- include('../partials/form-control', { name: 'audience', label: 'Audience', value: filters.audience, options: [{ value: '', label: 'All audiences' }, { value: 'everyone', label: 'Everyone' }, { value: 'admins', label: 'Admins' }, { value: 'teachers', label: 'Teachers' }, { value: 'students', label: 'Students' }, { value: 'guardians', label: 'Guardians' }, { value: 'class', label: 'Specific class' }, { value: 'section', label: 'Specific section' }] }) %>
      <%- include('../partials/form-control', { name: 'status', label: 'Status', value: filters.status, options: [{ value: '', label: 'All statuses' }, { value: 'draft', label: 'Draft' }, { value: 'published', label: 'Published' }] }) %>
    <% } %>
    <button class="btn btn-secondary" type="submit">Apply</button>
  </form>
</section>
<section class="panel overflow-x-auto" aria-labelledby="notices-title" tabindex="0">
  <table class="w-full border-collapse text-left text-sm">
    <caption id="notices-title" class="px-5 py-4 text-left font-semibold text-slate-900">Notice records</caption>
    <thead class="border-y border-slate-200 bg-slate-50 text-slate-600">
      <tr>
        <th scope="col" class="px-5 py-3 font-medium">Title</th>
        <th scope="col" class="px-5 py-3 font-medium">Audience</th>
        <th scope="col" class="px-5 py-3 font-medium">Visible</th>
        <% if (canManage) { %><th scope="col" class="px-5 py-3 font-medium">Status</th><% } %>
        <th scope="col" class="px-5 py-3 font-medium">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% for (const notice of records) { %>
        <tr>
          <td class="px-5 py-4 font-medium text-slate-900"><%= notice.title %></td>
          <td class="px-5 py-4 text-slate-600">
            <%= notice.audience %><% if (notice.class) { %> · <%= notice.class.name %><% } %><% if (notice.section) { %> / <%= notice.section.name %><% } %>
          </td>
          <td class="px-5 py-4 text-slate-600"><%= notice.visibleFrom ? notice.visibleFrom.toISOString().slice(0, 10) : 'Now' %> - <%= notice.visibleUntil ? notice.visibleUntil.toISOString().slice(0, 10) : 'Open' %></td>
          <% if (canManage) { %><td class="px-5 py-4 capitalize"><%= notice.status %></td><% } %>
          <td class="px-5 py-4">
            <div class="flex flex-wrap gap-2">
              <a href="/notices/<%= notice._id %>" class="btn btn-secondary">View</a>
              <% if (canManage) { %><a href="/notices/<%= notice._id %>/edit" class="btn btn-secondary">Edit</a><% } %>
            </div>
          </td>
        </tr>
      <% } %>
      <% if (records.length === 0) { %><tr><td colspan="<%= canManage ? 5 : 4 %>" class="px-5 py-10 text-center text-slate-500">No notices match the current filters.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../partials/pagination', { page: filters.page, totalPages, previousUrl, nextUrl }) %>
<%- include('../layouts/end') %>
