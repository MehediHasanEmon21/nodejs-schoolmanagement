<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Overview' }] }) %>
<%- include('../partials/header', { eyebrow: 'Your school, at a glance', heading: 'Dashboard', description: 'Welcome, ' + currentUser.name + '. Here’s your space to stay connected with school life.' }) %>
<section aria-labelledby="overview-title">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
    <h2 id="overview-title" class="text-base font-semibold text-slate-900">School overview</h2>
    <span class="text-xs text-slate-500">Metrics will appear as records become available</span>
  </div>
  <% if (dashboard.cards.length) { %>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      <% for (const card of dashboard.cards) { %><%- include('../partials/stat-card', card) %><% } %>
    </div>
  <% } else { %>
    <div class="panel"><%- include('../partials/empty-state', { heading: 'Your overview is ready', description: 'Available summaries will appear here when your school enables them.' }) %></div>
  <% } %>
</section>
<div class="mt-8 grid items-start gap-6 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]">
  <section class="panel overflow-hidden" aria-labelledby="workspace-title">
    <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
      <h2 id="workspace-title" class="font-semibold text-slate-900">Your workspace</h2>
      <p class="mt-1 text-sm text-slate-500">School tools available to your account.</p>
    </div>
    <% if (dashboard.modules.length) { %>
      <ul class="divide-y divide-slate-100">
        <% for (const item of dashboard.modules) { %>
          <li class="flex items-center justify-between gap-4 px-5 py-4 sm:px-6">
            <span class="flex items-center gap-3 text-sm font-medium text-slate-700"><span class="text-slate-400"><%- include('../partials/icon', { name: item.icon }) %></span><%= item.label %></span>
            <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-500">Coming soon</span>
          </li>
        <% } %>
      </ul>
    <% } else { %><%- include('../partials/empty-state', { heading: 'No tools to display', description: 'Contact your school administrator if you need access to additional school tools.' }) %><% } %>
  </section>
  <section class="panel overflow-hidden" aria-labelledby="updates-title">
    <div class="border-b border-slate-200 px-5 py-5 sm:px-6"><h2 id="updates-title" class="font-semibold text-slate-900">School updates</h2></div>
    <%- include('../partials/empty-state', { heading: 'A place to stay in the loop', description: 'School announcements will appear here when notices become available.' }) %>
  </section>
</div>
<%- include('../layouts/end') %>
