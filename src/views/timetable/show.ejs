<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Timetable', href: '/timetable' }, { label: entry.subject.name }] }) %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <%- include('../partials/header', { eyebrow: 'Timetable entry', heading: entry.subject.name, description: entry.class.name + ' / ' + entry.section.name + ' · ' + entry.day }) %>
  <% if (canManage) { %><a href="/timetable/<%= entry.id %>/edit" class="btn btn-primary">Edit</a><% } %>
</div>
<% if (message) { %><div class="mb-5"><%- include('../partials/alert', { kind: 'success', message }) %></div><% } %>
<section class="panel px-5 py-6 sm:px-6" aria-labelledby="entry-title">
  <h2 id="entry-title" class="mb-5 text-base font-semibold text-slate-900">Schedule details</h2>
  <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <div><dt class="text-sm text-slate-500">Academic year</dt><dd class="font-medium text-slate-900"><%= entry.academicYear.name %></dd></div>
    <div><dt class="text-sm text-slate-500">Class</dt><dd class="font-medium text-slate-900"><%= entry.class.name %> / <%= entry.section.name %></dd></div>
    <div><dt class="text-sm text-slate-500">Teacher</dt><dd class="font-medium text-slate-900"><%= entry.teacher.name %></dd></div>
    <div><dt class="text-sm text-slate-500">Day</dt><dd class="font-medium capitalize text-slate-900"><%= entry.day %></dd></div>
    <div><dt class="text-sm text-slate-500">Time</dt><dd class="font-medium text-slate-900"><%= entry.startTime %> - <%= entry.endTime %></dd></div>
    <div><dt class="text-sm text-slate-500">Room</dt><dd class="font-medium text-slate-900"><%= entry.room || 'Not assigned' %></dd></div>
    <div><dt class="text-sm text-slate-500">Status</dt><dd class="font-medium capitalize text-slate-900"><%= entry.status %></dd></div>
  </dl>
</section>
<%- include('../layouts/end') %>
