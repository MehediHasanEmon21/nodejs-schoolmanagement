<%- include('../layouts/start') %>
<%- include('../partials/header', { heading: 'Log in to your school', description: 'Use the account provided by your school administrator.' }) %>
<div class="max-w-md rounded-xl border border-slate-200 bg-white p-6">
  <% if (message) { %><%- include('../partials/alert', { kind: 'error', message }) %><% } %>
  <form method="post" action="/login" class="space-y-5">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../partials/form-control', { name: 'email', type: 'email', label: 'Email address', value: email, error: errors.email, required: true, autocomplete: 'username' }) %>
    <%- include('../partials/form-control', { name: 'password', type: 'password', label: 'Password', error: errors.password, required: true, autocomplete: 'current-password' }) %>
    <%- include('../partials/button', { type: 'submit', label: 'Log in' }) %>
  </form>
</div>
<%- include('../layouts/end') %>
