<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Reports', href: '/reports' }, { label: 'Attendance' }] }) %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <%- include('../partials/header', { eyebrow: 'Report', heading: 'Attendance report', description: totals.days + ' attendance days · present ' + totals.present + ' · absent ' + totals.absent }) %>
  <button type="button" class="btn btn-secondary" data-print-button>Print</button>
</div>
<section class="panel mb-5 px-5 py-5 sm:px-6 print:hidden" aria-labelledby="attendance-report-filters">
  <h2 id="attendance-report-filters" class="mb-4 text-base font-semibold text-slate-900">Filters</h2>
  <form method="get" action="/reports/attendance" class="grid gap-4 lg:grid-cols-6 lg:items-end">
    <%- include('../partials/form-control', { name: 'academicYear', label: 'Academic year', value: filters.academicYear, options: [{ value: '', label: 'All years' }, ...reportOptions.academicYears.map((item) => ({ value: item._id, label: item.name }))] }) %>
    <%- include('../partials/form-control', { name: 'class', label: 'Class', value: filters.class, options: [{ value: '', label: 'All classes' }, ...reportOptions.classes.map((item) => ({ value: item._id, label: item.name }))] }) %>
    <%- include('../partials/form-control', { name: 'section', label: 'Section', value: filters.section, options: [{ value: '', label: 'All sections' }, ...reportOptions.sections.map((item) => ({ value: item._id, label: (item.class?.name ? item.class.name + ' - ' : '') + item.name }))] }) %>
    <%- include('../partials/form-control', { name: 'dateFrom', type: 'date', label: 'From', value: filters.dateFrom }) %>
    <%- include('../partials/form-control', { name: 'dateTo', type: 'date', label: 'To', value: filters.dateTo }) %>
    <button class="btn btn-secondary" type="submit">Apply</button>
  </form>
</section>
<section class="panel overflow-x-auto" tabindex="0">
  <table class="w-full border-collapse text-left text-sm">
    <caption class="px-5 py-4 text-left font-semibold text-slate-900">Attendance records</caption>
    <thead class="border-y border-slate-200 bg-slate-50 text-slate-600"><tr><th class="px-5 py-3 font-medium">Date</th><th class="px-5 py-3 font-medium">Class</th><th class="px-5 py-3 font-medium">Present</th><th class="px-5 py-3 font-medium">Absent</th><th class="px-5 py-3 font-medium">Late</th><th class="px-5 py-3 font-medium">Excused</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% for (const item of records) { const counts = item.records.reduce((carry, record) => { carry[record.status] += 1; return carry; }, { present: 0, absent: 0, late: 0, excused: 0 }); %>
        <tr><td class="px-5 py-4 font-medium text-slate-900"><%= item.date.toISOString().slice(0, 10) %></td><td class="px-5 py-4 text-slate-600"><%= item.class.name %> / <%= item.section.name %></td><td class="px-5 py-4"><%= counts.present %></td><td class="px-5 py-4"><%= counts.absent %></td><td class="px-5 py-4"><%= counts.late %></td><td class="px-5 py-4"><%= counts.excused %></td></tr>
      <% } %>
      <% if (records.length === 0) { %><tr><td colspan="6" class="px-5 py-10 text-center text-slate-500">No attendance records match the filters.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../layouts/end') %>
