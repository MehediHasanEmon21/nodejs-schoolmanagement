<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Reports', href: '/reports' }, { label: 'Students' }] }) %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <%- include('../partials/header', { eyebrow: 'Report', heading: 'Student report', description: totals.total + ' students found.' }) %>
  <button type="button" class="btn btn-secondary" data-print-button>Print</button>
</div>
<section class="panel mb-5 px-5 py-5 sm:px-6 print:hidden" aria-labelledby="student-report-filters">
  <h2 id="student-report-filters" class="mb-4 text-base font-semibold text-slate-900">Filters</h2>
  <form method="get" action="/reports/students" class="grid gap-4 lg:grid-cols-[minmax(0,1.4fr)_repeat(3,minmax(0,1fr))_auto] lg:items-end">
    <%- include('../partials/form-control', { name: 'q', type: 'search', label: 'Search', value: filters.q }) %>
    <%- include('../partials/form-control', { name: 'status', label: 'Status', value: filters.status, options: [{ value: '', label: 'All statuses' }, { value: 'active', label: 'Active' }, { value: 'inactive', label: 'Inactive' }] }) %>
    <%- include('../partials/form-control', { name: 'class', label: 'Class', value: filters.class, options: [{ value: '', label: 'All classes' }, ...reportOptions.classes.map((item) => ({ value: item._id, label: item.name }))] }) %>
    <%- include('../partials/form-control', { name: 'section', label: 'Section', value: filters.section, options: [{ value: '', label: 'All sections' }, ...reportOptions.sections.map((item) => ({ value: item._id, label: (item.class?.name ? item.class.name + ' - ' : '') + item.name }))] }) %>
    <button class="btn btn-secondary" type="submit">Apply</button>
  </form>
</section>
<section class="panel overflow-x-auto" tabindex="0">
  <table class="w-full border-collapse text-left text-sm">
    <caption class="px-5 py-4 text-left font-semibold text-slate-900">Student records</caption>
    <thead class="border-y border-slate-200 bg-slate-50 text-slate-600"><tr><th class="px-5 py-3 font-medium">Student</th><th class="px-5 py-3 font-medium">ID</th><th class="px-5 py-3 font-medium">Class</th><th class="px-5 py-3 font-medium">Section</th><th class="px-5 py-3 font-medium">Status</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% for (const student of records) { %><tr><td class="px-5 py-4 font-medium text-slate-900"><%= student.firstName %> <%= student.lastName %></td><td class="px-5 py-4 text-slate-600"><%= student.studentId %></td><td class="px-5 py-4 text-slate-600"><%= student.class?.name ?? '-' %></td><td class="px-5 py-4 text-slate-600"><%= student.section?.name ?? '-' %></td><td class="px-5 py-4 capitalize"><%= student.status %></td></tr><% } %>
      <% if (records.length === 0) { %><tr><td colspan="5" class="px-5 py-10 text-center text-slate-500">No student records match the filters.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../layouts/end') %>
