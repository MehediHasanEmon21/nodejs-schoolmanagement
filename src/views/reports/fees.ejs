<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Reports', href: '/reports' }, { label: 'Fees' }] }) %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <%- include('../partials/header', { eyebrow: 'Report', heading: 'Fee report', description: 'Assigned ' + totals.amount.toFixed(2) + ' · paid ' + totals.paid.toFixed(2) + ' · outstanding ' + totals.outstanding.toFixed(2) }) %>
  <button type="button" class="btn btn-secondary" data-print-button>Print</button>
</div>
<section class="panel mb-5 px-5 py-5 sm:px-6 print:hidden" aria-labelledby="fee-report-filters">
  <h2 id="fee-report-filters" class="mb-4 text-base font-semibold text-slate-900">Filters</h2>
  <form method="get" action="/reports/fees" class="grid gap-4 lg:grid-cols-5 lg:items-end">
    <%- include('../partials/form-control', { name: 'academicYear', label: 'Academic year', value: filters.academicYear, options: [{ value: '', label: 'All years' }, ...reportOptions.academicYears.map((item) => ({ value: item._id, label: item.name }))] }) %>
    <%- include('../partials/form-control', { name: 'feeType', label: 'Fee type', value: filters.feeType, options: [{ value: '', label: 'All fee types' }, ...reportOptions.feeTypes.map((item) => ({ value: item._id, label: item.name }))] }) %>
    <%- include('../partials/form-control', { name: 'status', label: 'Status', value: filters.status, options: [{ value: '', label: 'All statuses' }, { value: 'pending', label: 'Pending' }, { value: 'partial', label: 'Partial' }, { value: 'paid', label: 'Paid' }, { value: 'waived', label: 'Waived' }, { value: 'cancelled', label: 'Cancelled' }] }) %>
    <button class="btn btn-secondary" type="submit">Apply</button>
  </form>
</section>
<section class="panel overflow-x-auto" tabindex="0">
  <table class="w-full border-collapse text-left text-sm">
    <caption class="px-5 py-4 text-left font-semibold text-slate-900">Fee records</caption>
    <thead class="border-y border-slate-200 bg-slate-50 text-slate-600"><tr><th class="px-5 py-3 font-medium">Student</th><th class="px-5 py-3 font-medium">Fee</th><th class="px-5 py-3 font-medium">Due</th><th class="px-5 py-3 font-medium">Amount</th><th class="px-5 py-3 font-medium">Paid</th><th class="px-5 py-3 font-medium">Outstanding</th><th class="px-5 py-3 font-medium">Status</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% for (const fee of records) { %><tr><td class="px-5 py-4 font-medium text-slate-900"><%= fee.student.firstName %> <%= fee.student.lastName %></td><td class="px-5 py-4 text-slate-600"><%= fee.feeType.name %></td><td class="px-5 py-4 text-slate-600"><%= fee.dueDate.toISOString().slice(0, 10) %></td><td class="px-5 py-4"><%= fee.amount.toFixed(2) %></td><td class="px-5 py-4"><%= fee.paidAmount.toFixed(2) %></td><td class="px-5 py-4"><%= fee.outstanding.toFixed(2) %></td><td class="px-5 py-4 capitalize"><%= fee.status %></td></tr><% } %>
      <% if (records.length === 0) { %><tr><td colspan="7" class="px-5 py-10 text-center text-slate-500">No fee records match the filters.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../layouts/end') %>
