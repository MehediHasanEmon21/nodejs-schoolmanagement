<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Reports', href: '/reports' }, { label: 'Results' }] }) %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <%- include('../partials/header', { eyebrow: 'Report', heading: 'Result report', description: exam ? exam.name + ' · ' + totals.students + ' students' : 'Choose an exam to generate a result report.' }) %>
  <button type="button" class="btn btn-secondary" data-print-button>Print</button>
</div>
<section class="panel mb-5 px-5 py-5 sm:px-6 print:hidden" aria-labelledby="result-report-filters">
  <h2 id="result-report-filters" class="mb-4 text-base font-semibold text-slate-900">Filters</h2>
  <form method="get" action="/reports/results" class="grid gap-4 lg:grid-cols-3 lg:items-end">
    <%- include('../partials/form-control', { name: 'exam', label: 'Exam', value: filters.exam, options: [{ value: '', label: 'Choose an exam' }, ...reportOptions.exams.map((item) => ({ value: item._id, label: item.name + ' · ' + item.class.name + ' · ' + item.academicYear.name }))] }) %>
    <%- include('../partials/form-control', { name: 'section', label: 'Section', value: filters.section, options: [{ value: '', label: 'All sections' }, ...reportOptions.sections.map((item) => ({ value: item._id, label: (item.class?.name ? item.class.name + ' - ' : '') + item.name }))] }) %>
    <button class="btn btn-secondary" type="submit">Apply</button>
  </form>
</section>
<section class="panel overflow-x-auto" tabindex="0">
  <table class="w-full border-collapse text-left text-sm">
    <caption class="px-5 py-4 text-left font-semibold text-slate-900">Result records</caption>
    <thead class="border-y border-slate-200 bg-slate-50 text-slate-600"><tr><th class="px-5 py-3 font-medium">Student</th><th class="px-5 py-3 font-medium">Section</th><th class="px-5 py-3 font-medium">Roll</th><th class="px-5 py-3 font-medium">Marks</th><th class="px-5 py-3 font-medium">Grade</th><th class="px-5 py-3 font-medium">Result</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% for (const row of rows) { %><tr><td class="px-5 py-4 font-medium text-slate-900"><%= row.enrollment.student.firstName %> <%= row.enrollment.student.lastName %></td><td class="px-5 py-4 text-slate-600"><%= row.enrollment.section.name %></td><td class="px-5 py-4 text-slate-600"><%= row.enrollment.rollNumber %></td><td class="px-5 py-4"><%= row.summary.marksObtained %>/<%= row.summary.totalMarks %></td><td class="px-5 py-4"><%= row.summary.grade %></td><td class="px-5 py-4"><%= row.summary.passed ? 'Pass' : 'Fail' %></td></tr><% } %>
      <% if (rows.length === 0) { %><tr><td colspan="6" class="px-5 py-10 text-center text-slate-500">No result records match the filters.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../layouts/end') %>
