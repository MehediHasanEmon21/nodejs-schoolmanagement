<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Exams' }] }) %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <%- include('../partials/header', { eyebrow: 'Exam setup', heading: 'Exams', description: 'Define exam windows and subject mark settings for each class.' }) %>
  <% if (canManage) { %><a href="/exams/new" class="btn btn-primary">New exam</a><% } %>
</div>
<% if (message) { %><div class="mb-5"><%- include('../partials/alert', { kind: 'success', message }) %></div><% } %>
<section class="panel mb-5 px-5 py-5 sm:px-6" aria-labelledby="exam-filters-title">
  <h2 id="exam-filters-title" class="mb-4 text-base font-semibold text-slate-900">Find exams</h2>
  <form method="get" action="/exams" class="grid gap-4 lg:grid-cols-[repeat(4,minmax(0,1fr))_auto] lg:items-end">
    <%- include('../partials/form-control', { name: 'academicYear', label: 'Academic year', value: filters.academicYear, options: [{ value: '', label: 'All years' }, ...formOptions.academicYears.map((item) => ({ value: item._id, label: item.name }))] }) %>
    <%- include('../partials/form-control', { name: 'class', label: 'Class', value: filters.class, options: [{ value: '', label: 'All classes' }, ...formOptions.classes.map((item) => ({ value: item._id, label: item.name }))] }) %>
    <%- include('../partials/form-control', { name: 'status', label: 'Status', value: filters.status, options: [{ value: '', label: 'All statuses' }, { value: 'draft', label: 'Draft' }, { value: 'scheduled', label: 'Scheduled' }, { value: 'completed', label: 'Completed' }, { value: 'cancelled', label: 'Cancelled' }] }) %>
    <%- include('../partials/form-control', { name: 'sort', label: 'Sort', value: filters.sort, options: [{ value: 'startDate', label: 'Start date' }, { value: 'name', label: 'Name' }, { value: 'status', label: 'Status' }] }) %>
    <button class="btn btn-secondary" type="submit">Apply</button>
  </form>
</section>
<section class="panel overflow-x-auto" aria-labelledby="exams-title" tabindex="0">
  <table class="w-full border-collapse text-left text-sm">
    <caption id="exams-title" class="px-5 py-4 text-left font-semibold text-slate-900">Exam records</caption>
    <thead class="border-y border-slate-200 bg-slate-50 text-slate-600">
      <tr><th scope="col" class="px-5 py-3 font-medium">Exam</th><th scope="col" class="px-5 py-3 font-medium">Year</th><th scope="col" class="px-5 py-3 font-medium">Class</th><th scope="col" class="px-5 py-3 font-medium">Dates</th><th scope="col" class="px-5 py-3 font-medium">Subjects</th><th scope="col" class="px-5 py-3 font-medium">Status</th><th scope="col" class="px-5 py-3 font-medium">Actions</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% for (const exam of records) { %>
        <tr>
          <td class="px-5 py-4 font-medium text-slate-900"><a href="/exams/<%= exam._id %>" class="hover:text-teal-800"><%= exam.name %></a></td>
          <td class="px-5 py-4 text-slate-600"><%= exam.academicYear.name %></td>
          <td class="px-5 py-4 text-slate-600"><%= exam.class.name %></td>
          <td class="px-5 py-4 text-slate-600"><%= exam.startDate.toISOString().slice(0, 10) %> to <%= exam.endDate.toISOString().slice(0, 10) %></td>
          <td class="px-5 py-4 text-slate-600"><%= exam.subjects.length %></td>
          <td class="px-5 py-4"><%= exam.status[0].toUpperCase() + exam.status.slice(1) %></td>
          <td class="px-5 py-4">
            <div class="flex flex-wrap gap-2">
              <a href="/exams/<%= exam._id %>" class="btn btn-secondary">View</a>
              <% if (canManage) { %><a href="/exams/<%= exam._id %>/edit" class="btn btn-secondary">Edit</a><% } %>
            </div>
          </td>
        </tr>
      <% } %>
      <% if (records.length === 0) { %><tr><td colspan="7" class="px-5 py-10 text-center text-slate-500">No exams match the current filters.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../partials/pagination', { page: filters.page, totalPages, previousUrl, nextUrl }) %>
<%- include('../layouts/end') %>
