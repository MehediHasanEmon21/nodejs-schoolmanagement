<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Exams', href: '/exams' }, { label: exam.name }] }) %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <%- include('../partials/header', { eyebrow: 'Exam', heading: exam.name, description: exam.class.name + ' · ' + exam.academicYear.name }) %>
  <% if (canManage) { %><a href="/exams/<%= exam.id %>/edit" class="btn btn-primary">Edit</a><% } %>
</div>
<section class="panel px-5 py-6 sm:px-6" aria-labelledby="exam-details-title">
  <h2 id="exam-details-title" class="mb-5 text-base font-semibold text-slate-900">Exam details</h2>
  <dl class="grid gap-5 sm:grid-cols-2">
    <div><dt class="text-xs font-semibold uppercase tracking-widest text-slate-500">Academic year</dt><dd class="mt-1 text-slate-900"><%= exam.academicYear.name %></dd></div>
    <div><dt class="text-xs font-semibold uppercase tracking-widest text-slate-500">Class</dt><dd class="mt-1 text-slate-900"><%= exam.class.name %></dd></div>
    <div><dt class="text-xs font-semibold uppercase tracking-widest text-slate-500">Dates</dt><dd class="mt-1 text-slate-900"><%= exam.startDate.toISOString().slice(0, 10) %> to <%= exam.endDate.toISOString().slice(0, 10) %></dd></div>
    <div><dt class="text-xs font-semibold uppercase tracking-widest text-slate-500">Status</dt><dd class="mt-1 text-slate-900"><%= exam.status[0].toUpperCase() + exam.status.slice(1) %></dd></div>
  </dl>
</section>
<section class="panel mt-6 overflow-x-auto" aria-labelledby="exam-subjects-title" tabindex="0">
  <table class="w-full border-collapse text-left text-sm">
    <caption id="exam-subjects-title" class="px-5 py-4 text-left font-semibold text-slate-900">Subject setup</caption>
    <thead class="border-y border-slate-200 bg-slate-50 text-slate-600">
      <tr><th scope="col" class="px-5 py-3 font-medium">Subject</th><th scope="col" class="px-5 py-3 font-medium">Total marks</th><th scope="col" class="px-5 py-3 font-medium">Pass marks</th><th scope="col" class="px-5 py-3 font-medium">Exam date</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% for (const row of exam.subjects) { %>
        <tr>
          <td class="px-5 py-4 font-medium text-slate-900"><%= row.subject.name %></td>
          <td class="px-5 py-4 text-slate-600"><%= row.totalMarks %></td>
          <td class="px-5 py-4 text-slate-600"><%= row.passMarks %></td>
          <td class="px-5 py-4 text-slate-600"><%= row.examDate ? row.examDate.toISOString().slice(0, 10) : '-' %></td>
        </tr>
      <% } %>
      <% if (exam.subjects.length === 0) { %><tr><td colspan="4" class="px-5 py-10 text-center text-slate-500">No subjects configured.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../layouts/end') %>
