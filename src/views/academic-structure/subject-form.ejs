<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Subjects', href: '/subjects' }, { label: record ? 'Edit' : 'New' }] }) %>
<%- include('../partials/header', { eyebrow: 'Academic structure', heading: record ? 'Edit subject' : 'New subject', description: 'Assign each subject to one or more classes.' }) %>
<% if (message) { %><div class="mb-5"><%- include('../partials/alert', { kind: 'error', message }) %></div><% } %>
<section class="panel px-5 py-6 sm:px-6" aria-labelledby="subject-form-title">
  <h2 id="subject-form-title" class="mb-5 text-base font-semibold text-slate-900">Subject details</h2>
  <form method="post" action="<%= record ? '/subjects/' + record.id : '/subjects' %>" class="space-y-5" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../partials/form-control', { name: 'name', label: 'Name', value: values.name, error: errors.name, required: true, hint: 'Example: Mathematics' }) %>
    <%- include('../partials/form-control', { name: 'code', label: 'Code', value: values.code, error: errors.code, hint: 'Optional, such as MATH' }) %>
    <fieldset class="space-y-3">
      <legend class="text-sm font-medium text-slate-800">Classes <span aria-hidden="true">*</span></legend>
      <% if (classes.length) { %>
        <div class="grid gap-2 sm:grid-cols-2">
          <% for (const item of classes) { %>
            <label class="flex items-center gap-3 rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700">
              <input type="checkbox" name="classes" value="<%= item._id %>" class="h-4 w-4 rounded border-slate-300 text-teal-800 focus:ring-teal-700" <% if (values.classes.includes(String(item._id))) { %>checked<% } %>>
              <span><%= item.name %></span>
            </label>
          <% } %>
        </div>
      <% } else { %>
        <p class="text-sm text-slate-500">Create a class before assigning subjects.</p>
      <% } %>
      <% if (errors.classes) { %><p class="text-sm text-red-700"><%= errors.classes %></p><% } %>
    </fieldset>
    <%- include('../partials/form-control', { name: 'status', label: 'Status', value: values.status, error: errors.status, options: [{ value: 'active', label: 'Active' }, { value: 'inactive', label: 'Inactive' }], required: true }) %>
    <div class="flex flex-wrap gap-3">
      <%- include('../partials/button', { type: 'submit', label: record ? 'Save changes' : 'Create subject' }) %>
      <a href="/subjects" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</section>
<%- include('../layouts/end') %>
