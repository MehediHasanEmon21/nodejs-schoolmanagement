<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Sections' }] }) %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <%- include('../partials/header', { eyebrow: 'Academic structure', heading: 'Sections', description: 'Split classes into teachable groups such as Section A or Section B.' }) %>
  <a href="/sections/new" class="btn btn-primary">New section</a>
</div>
<% if (message) { %><div class="mb-5"><%- include('../partials/alert', { kind: 'success', message }) %></div><% } %>
<section class="panel overflow-x-auto" aria-labelledby="sections-title" tabindex="0">
  <table class="w-full border-collapse text-left text-sm">
    <caption id="sections-title" class="px-5 py-4 text-left font-semibold text-slate-900">Section records</caption>
    <thead class="border-y border-slate-200 bg-slate-50 text-slate-600"><tr><th scope="col" class="px-5 py-3 font-medium">Section</th><th scope="col" class="px-5 py-3 font-medium">Class</th><th scope="col" class="px-5 py-3 font-medium">Status</th><th scope="col" class="px-5 py-3 font-medium">Actions</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% for (const record of records) { %>
        <tr>
          <td class="px-5 py-4 font-medium text-slate-900"><%= record.name %></td>
          <td class="px-5 py-4 text-slate-600"><%= record.class?.name ?? 'Missing class' %></td>
          <td class="px-5 py-4 capitalize"><%= record.status %></td>
          <td class="px-5 py-4"><a href="/sections/<%= record._id %>/edit" class="btn btn-secondary">Edit</a></td>
        </tr>
      <% } %>
      <% if (records.length === 0) { %><tr><td colspan="4" class="px-5 py-10 text-center text-slate-500">No sections have been created yet.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../layouts/end') %>
