<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Classes' }] }) %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <%- include('../partials/header', { eyebrow: 'Academic structure', heading: 'Classes', description: 'Create the grade levels used by sections, subjects and future enrollments.' }) %>
  <a href="/classes/new" class="btn btn-primary">New class</a>
</div>
<% if (message) { %><div class="mb-5"><%- include('../partials/alert', { kind: 'success', message }) %></div><% } %>
<section class="panel overflow-x-auto" aria-labelledby="classes-title" tabindex="0">
  <table class="w-full border-collapse text-left text-sm">
    <caption id="classes-title" class="px-5 py-4 text-left font-semibold text-slate-900">Class records</caption>
    <thead class="border-y border-slate-200 bg-slate-50 text-slate-600"><tr><th scope="col" class="px-5 py-3 font-medium">Name</th><th scope="col" class="px-5 py-3 font-medium">Status</th><th scope="col" class="px-5 py-3 font-medium">Actions</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% for (const record of records) { %>
        <tr>
          <td class="px-5 py-4 font-medium text-slate-900"><%= record.name %></td>
          <td class="px-5 py-4 capitalize"><%= record.status %></td>
          <td class="px-5 py-4"><a href="/classes/<%= record._id %>/edit" class="btn btn-secondary">Edit</a></td>
        </tr>
      <% } %>
      <% if (records.length === 0) { %><tr><td colspan="3" class="px-5 py-10 text-center text-slate-500">No classes have been created yet.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../layouts/end') %>
