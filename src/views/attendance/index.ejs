<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Attendance' }] }) %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <%- include('../partials/header', { eyebrow: 'Daily attendance', heading: 'Attendance', description: 'Review recorded class attendance and open daily rosters.' }) %>
  <% if (canManage || currentRoleName === 'Teacher') { %><a href="/attendance/new" class="btn btn-primary">Record attendance</a><% } %>
</div>
<% if (message) { %><div class="mb-5"><%- include('../partials/alert', { kind: 'success', message }) %></div><% } %>
<section class="panel mb-5 px-5 py-5 sm:px-6" aria-labelledby="attendance-filters-title">
  <h2 id="attendance-filters-title" class="mb-4 text-base font-semibold text-slate-900">Find attendance</h2>
  <form method="get" action="/attendance" class="grid gap-4 lg:grid-cols-[repeat(5,minmax(0,1fr))_auto] lg:items-end">
    <%- include('../partials/form-control', { name: 'academicYear', label: 'Academic year', value: filters.academicYear, options: [{ value: '', label: 'All years' }, ...formOptions.academicYears.map((item) => ({ value: item._id, label: item.name }))] }) %>
    <%- include('../partials/form-control', { name: 'class', label: 'Class', value: filters.class, options: [{ value: '', label: 'All classes' }, ...formOptions.classes.map((item) => ({ value: item._id, label: item.name }))] }) %>
    <%- include('../partials/form-control', { name: 'section', label: 'Section', value: filters.section, options: [{ value: '', label: 'All sections' }, ...formOptions.sections.map((item) => ({ value: item._id, label: (item.class?.name ? item.class.name + ' - ' : '') + item.name }))] }) %>
    <%- include('../partials/form-control', { name: 'date', type: 'date', label: 'Date', value: filters.date }) %>
    <%- include('../partials/form-control', { name: 'sort', label: 'Sort', value: filters.sort, options: [{ value: 'date', label: 'Date' }, { value: 'class', label: 'Class' }] }) %>
    <button class="btn btn-secondary" type="submit">Apply</button>
  </form>
</section>
<section class="panel overflow-x-auto" aria-labelledby="attendance-title" tabindex="0">
  <table class="w-full border-collapse text-left text-sm">
    <caption id="attendance-title" class="px-5 py-4 text-left font-semibold text-slate-900">Attendance records</caption>
    <thead class="border-y border-slate-200 bg-slate-50 text-slate-600">
      <tr>
        <th scope="col" class="px-5 py-3 font-medium">Date</th>
        <th scope="col" class="px-5 py-3 font-medium">Year</th>
        <th scope="col" class="px-5 py-3 font-medium">Class</th>
        <th scope="col" class="px-5 py-3 font-medium">Section</th>
        <th scope="col" class="px-5 py-3 font-medium">Students</th>
        <th scope="col" class="px-5 py-3 font-medium">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% for (const item of records) { %>
        <tr>
          <td class="px-5 py-4 font-medium text-slate-900"><a href="/attendance/<%= item._id %>" class="hover:text-teal-800"><%= item.date.toISOString().slice(0, 10) %></a></td>
          <td class="px-5 py-4 text-slate-600"><%= item.academicYear.name %></td>
          <td class="px-5 py-4 text-slate-600"><a href="/attendance/classes/<%= item.class._id %>/summary" class="hover:text-teal-800"><%= item.class.name %></a></td>
          <td class="px-5 py-4 text-slate-600"><%= item.section.name %></td>
          <td class="px-5 py-4 text-slate-600"><%= item.records.length %></td>
          <td class="px-5 py-4"><a href="/attendance/<%= item._id %>" class="btn btn-secondary">View</a></td>
        </tr>
      <% } %>
      <% if (records.length === 0) { %><tr><td colspan="6" class="px-5 py-10 text-center text-slate-500">No attendance records match the current filters.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../partials/pagination', { page: filters.page, totalPages, previousUrl, nextUrl }) %>
<%- include('../layouts/end') %>
