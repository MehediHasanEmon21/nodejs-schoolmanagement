<%- include('../layouts/start') %>
<%- include('../partials/breadcrumbs', { items: [{ label: 'Your school', href: '/' }, { label: 'Students' }] }) %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <%- include('../partials/header', { eyebrow: 'Student management', heading: 'Students', description: 'Search, filter and manage student records without storing enrollment history directly on the profile.' }) %>
  <% if (canManage) { %><a href="/students/new" class="btn btn-primary">New student</a><% } %>
</div>
<% if (message) { %><div class="mb-5"><%- include('../partials/alert', { kind: 'success', message }) %></div><% } %>
<section class="panel mb-5 px-5 py-5 sm:px-6" aria-labelledby="student-filters-title">
  <h2 id="student-filters-title" class="mb-4 text-base font-semibold text-slate-900">Find students</h2>
  <form method="get" action="/students" class="grid gap-4 lg:grid-cols-[minmax(0,1.4fr)_repeat(3,minmax(0,1fr))_auto] lg:items-end">
    <%- include('../partials/form-control', { name: 'q', type: 'search', label: 'Search', value: filters.q, hint: 'Name, student ID or phone' }) %>
    <%- include('../partials/form-control', { name: 'status', label: 'Status', value: filters.status, options: [{ value: '', label: 'All statuses' }, { value: 'active', label: 'Active' }, { value: 'inactive', label: 'Inactive' }] }) %>
    <%- include('../partials/form-control', { name: 'class', label: 'Class', value: filters.class, options: [{ value: '', label: 'All classes' }, ...classes.map((item) => ({ value: item._id, label: item.name }))] }) %>
    <%- include('../partials/form-control', { name: 'sort', label: 'Sort', value: filters.sort, options: [{ value: 'name', label: 'Name' }, { value: 'studentId', label: 'Student ID' }, { value: 'admissionDate', label: 'Admission date' }, { value: 'status', label: 'Status' }] }) %>
    <button class="btn btn-secondary" type="submit">Apply</button>
  </form>
</section>
<section class="panel overflow-x-auto" aria-labelledby="students-title" tabindex="0">
  <table class="w-full border-collapse text-left text-sm">
    <caption id="students-title" class="px-5 py-4 text-left font-semibold text-slate-900">Student records</caption>
    <thead class="border-y border-slate-200 bg-slate-50 text-slate-600">
      <tr>
        <th scope="col" class="px-5 py-3 font-medium">Student</th>
        <th scope="col" class="px-5 py-3 font-medium">ID</th>
        <th scope="col" class="px-5 py-3 font-medium">Class</th>
        <th scope="col" class="px-5 py-3 font-medium">Section</th>
        <th scope="col" class="px-5 py-3 font-medium">Status</th>
        <th scope="col" class="px-5 py-3 font-medium">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% for (const student of records) { %>
        <tr>
          <td class="px-5 py-4 font-medium text-slate-900"><a href="/students/<%= student._id %>" class="hover:text-teal-800"><%= student.firstName %> <%= student.lastName %></a></td>
          <td class="px-5 py-4 text-slate-600"><%= student.studentId %></td>
          <td class="px-5 py-4 text-slate-600"><%= student.class?.name ?? '—' %></td>
          <td class="px-5 py-4 text-slate-600"><%= student.section?.name ?? '—' %></td>
          <td class="px-5 py-4 capitalize"><%= student.status %></td>
          <td class="px-5 py-4">
            <div class="flex flex-wrap gap-2">
              <a href="/students/<%= student._id %>" class="btn btn-secondary">View</a>
              <% if (canManage) { %><a href="/students/<%= student._id %>/edit" class="btn btn-secondary">Edit</a><% } %>
            </div>
          </td>
        </tr>
      <% } %>
      <% if (records.length === 0) { %><tr><td colspan="6" class="px-5 py-10 text-center text-slate-500">No students match the current filters.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../partials/pagination', { page: filters.page, totalPages, previousUrl, nextUrl }) %>
<%- include('../layouts/end') %>
