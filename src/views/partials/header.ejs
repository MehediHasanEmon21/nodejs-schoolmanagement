<div class="mb-8">
  <% if (locals.eyebrow) { %><p class="mb-3 text-xs font-semibold tracking-widest text-teal-800 uppercase"><%= eyebrow %></p><% } %>
  <h1 class="text-3xl font-semibold tracking-tight break-words text-slate-950 sm:text-4xl"><%= heading %></h1>
  <% if (locals.description) { %><p class="mt-4 max-w-2xl text-base leading-7 break-words text-slate-600"><%= description %></p><% } %>
</div>
