<div class="panel overflow-x-auto" role="region" aria-label="<%= caption %>" tabindex="0">
  <table class="w-full border-collapse text-left text-sm">
    <caption class="px-5 py-4 text-left font-semibold text-slate-900"><%= caption %></caption>
    <thead class="border-y border-slate-200 bg-slate-50 text-slate-600"><tr><% for (const column of columns) { %><th scope="col" class="px-5 py-3 font-medium"><%= column.label %></th><% } %></tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% for (const row of rows) { %><tr><% for (const column of columns) { %><td class="px-5 py-4"><%= row[column.key] ?? '—' %></td><% } %></tr><% } %>
      <% if (rows.length === 0) { %><tr><td colspan="<%= columns.length %>" class="px-5 py-10 text-center text-slate-500"><%= locals.emptyMessage || 'No records to display.' %></td></tr><% } %>
    </tbody>
  </table>
</div>
