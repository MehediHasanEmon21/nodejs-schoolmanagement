<aside id="site-menu" data-menu class="border-b border-slate-200 bg-white px-5 py-6 md:border-r md:border-b-0 md:py-8">
  <nav aria-label="Main navigation">
    <p class="mb-4 px-3 text-xs font-semibold tracking-widest text-slate-500 uppercase">Your school</p>
    <a href="/" class="block rounded-lg px-3 py-3 text-sm font-semibold <%= activePage === 'home' ? 'bg-teal-50 text-teal-900' : 'text-slate-600 hover:bg-slate-100' %>" <% if (activePage === 'home') { %>aria-current="page"<% } %>>Welcome</a>
    <a href="/#about" class="mt-1 block rounded-lg px-3 py-3 text-sm text-slate-600 hover:bg-slate-100">About this space</a>
    <% if (navigation.length) { %>
      <p class="mt-8 mb-3 px-3 text-xs font-semibold tracking-widest text-slate-500 uppercase">Workspace</p>
      <ul class="space-y-1">
        <% for (const item of navigation) { %>
          <li>
            <% if (item.href) { %>
              <a href="<%= item.href %>" class="flex items-center gap-3 rounded-lg px-3 py-3 text-sm font-semibold <%= activePage === item.id ? 'bg-teal-50 text-teal-900' : 'text-slate-600 hover:bg-slate-100' %>" <% if (activePage === item.id) { %>aria-current="page"<% } %>><%- include('icon', { name: item.icon }) %><%= item.label %></a>
            <% } else { %>
              <span class="flex items-center gap-3 rounded-lg px-3 py-3 text-sm text-slate-500" aria-disabled="true"><%- include('icon', { name: item.icon }) %><span class="flex-1"><%= item.label %></span><span class="text-[10px] font-semibold uppercase">Soon</span></span>
            <% } %>
          </li>
        <% } %>
      </ul>
    <% } %>
  </nav>
</aside>
