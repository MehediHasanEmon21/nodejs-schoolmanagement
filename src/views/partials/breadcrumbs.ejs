<nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-500"><ol class="flex flex-wrap items-center gap-2">
  <% items.forEach((item, index) => { %>
    <li class="flex items-center gap-2"><% if (index > 0) { %><span aria-hidden="true">/</span><% } %><% if (item.href && index < items.length - 1) { %><a href="<%= item.href %>" class="hover:text-teal-800"><%= item.label %></a><% } else { %><span aria-current="page" class="text-slate-700"><%= item.label %></span><% } %></li>
  <% }); %>
</ol></nav>
