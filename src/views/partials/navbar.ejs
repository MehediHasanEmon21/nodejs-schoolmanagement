<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-5 sm:px-8">
    <a href="/" class="flex items-center gap-3 font-semibold tracking-tight text-slate-900">
      <img src="/images/school-mark.svg" alt="" width="40" height="40">
      <span>School Management</span>
    </a>
    <button type="button" class="btn btn-secondary md:hidden" data-menu-toggle aria-controls="site-menu" aria-expanded="true" hidden>Menu</button>
    <% if (currentUser) { %>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('button', { type: 'submit', label: 'Log out', variant: 'secondary' }) %>
      </form>
    <% } else { %>
      <a href="/login" class="btn btn-secondary">Log in</a>
    <% } %>
  </div>
</header>
