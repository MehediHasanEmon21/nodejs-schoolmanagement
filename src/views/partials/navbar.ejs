<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-5 py-4 sm:px-8">
    <a href="<%= navigation.some((item) => item.id === 'dashboard') ? '/dashboard' : '/' %>" class="mr-auto flex min-w-0 items-center gap-2 text-sm font-semibold tracking-tight text-slate-900 sm:gap-3 sm:text-base">
      <img src="/images/school-mark.svg" alt="" width="36" height="36" class="shrink-0">
      <span>School Management</span>
    </a>
    <button type="button" class="btn btn-secondary md:hidden" data-menu-toggle aria-controls="site-menu" aria-expanded="true" hidden>Menu</button>
    <% if (currentUser) { %>
      <div class="flex w-full items-center justify-between gap-4 border-t border-slate-100 pt-3 sm:w-auto sm:border-0 sm:pt-0">
        <div class="min-w-0 max-w-48">
          <p class="truncate text-sm font-semibold text-slate-700"><%= currentUser.name %></p>
          <% if (currentRoleName) { %><p class="truncate text-xs text-slate-500"><%= currentRoleName %></p><% } %>
        </div>
        <form method="post" action="/logout" data-confirm-dialog="logout-dialog" class="shrink-0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <%- include('button', { type: 'submit', label: 'Log out', variant: 'secondary' }) %>
        </form>
      </div>
    <% } else { %>
      <a href="/login" class="btn btn-secondary">Log in</a>
    <% } %>
  </div>
</header>
