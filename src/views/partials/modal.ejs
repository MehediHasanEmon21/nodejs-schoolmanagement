<dialog id="<%= id %>" class="modal panel p-0" aria-labelledby="<%= id %>-title" aria-describedby="<%= id %>-description">
  <div class="p-6 sm:p-8">
    <h2 id="<%= id %>-title" class="text-xl font-semibold tracking-tight text-slate-950"><%= title %></h2>
    <p id="<%= id %>-description" class="mt-3 text-sm leading-6 text-slate-600"><%= description %></p>
    <div class="mt-6 flex flex-wrap justify-end gap-3">
      <form method="dialog"><button type="submit" class="btn btn-secondary" autofocus><%= locals.cancelLabel || 'Cancel' %></button></form>
      <% if (locals.action && locals.confirmLabel) { %>
        <form method="post" action="<%= action %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <%- include('button', { type: 'submit', label: confirmLabel }) %>
        </form>
      <% } %>
    </div>
  </div>
</dialog>
