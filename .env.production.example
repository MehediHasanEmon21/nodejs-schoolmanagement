NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb://mongo:27017/school_management
SESSION_SECRET=replace_with_a_generated_secret_at_least_32_chars
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=720
# Use true, a hop count, or trusted proxy names/IPs only when TLS terminates before Node.
TRUST_PROXY=loopback
TZ=Asia/Dhaka
